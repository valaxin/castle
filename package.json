{
  "name": "castle",
  "version": "0.0.2",
  "description": "~",
  "repository": "https://github.com/valaxin/castle",
  "author": "valaxin",
  "license": "MIT",
  "main": "/app/index.js",
  "type": "module",
  "scripts": {
    "analyze": "rm -rf ./dist && webpack --profile --json > stats.json && webpack-bundle-analyzer stats.json ./dist",
    "build": "NODE_ENV=production rm -rf ./dist && node --no-experimental-require-module --experimental-print-required-tla ./node_modules/.bin/webpack build",
    "clean": "rm -rf ./src/public/template-data.json ./src/public/feed.xml ./src/public/feed.json ./src/public/manifest.json",
    "dev": "echo 'removing previous /dist folder and some generated public files' && rm -rf ./dist && npm run clean && node --no-experimental-require-module --experimental-print-required-tla ./node_modules/.bin/webpack serve --hot --port=3000"
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@mdit/plugin-abbr": "^0.16.0",
    "@mdit/plugin-container": "^0.16.0",
    "@mdit/plugin-footnote": "^0.16.8",
    "@mdit/plugin-img-lazyload": "^0.16.0",
    "@mdit/plugin-ins": "^0.16.0",
    "@mdit/plugin-mark": "^0.16.0",
    "@mdit/plugin-sub": "^0.16.0",
    "@mdit/plugin-sup": "^0.16.0",
    "@mdit/plugin-tasklist": "^0.16.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "bulma": "^1.0.4",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "3.39.0",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.7",
    "feed": "^4.2.2",
    "fontawesome-free": "^1.0.4",
    "highlight.js": "^11.11.1",
    "html-webpack-plugin": "^5.6.3",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-kbd": "^3.0.0",
    "markdown-it-video": "^0.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "moment": "^2.30.1",
    "postcss-loader": "^8.1.1",
    "postcss-nested": "^7.0.2",
    "pug": "^3.0.3",
    "raw-loader": "^4.0.2",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "tocbot": "^4.36.3",
    "webpack": "^5.99.5",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1"
  }
}
