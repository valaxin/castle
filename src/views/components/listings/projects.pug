section.section#projects
  if (self.repos)
    h2.title.section-title Projects
    ul.block
      each project of self.repos
        li
          a.repo(href= project.html_url target="_blank")
            
            if (project.name === 'scrambled')
              img(src='@images/resources/abstract.jpg', alt='Vibrant Abstract Digital Art with Fluid Dynamics [Steve Johnson]')
            else if (project.name === 'castle')
              img(src='@images/resources/castle.jpg' alt='Hohenschwangau Castle in Germany [Jusuf Rujanac]')
            else if (project.name === 'valaxin')
              img(src='@images/resources/great-wall.jpg' alt='Great Wall of China Snaking Through Verdant Hills [Jens F]')
            else
              img(src='@images/resources/empty-package.jpg' alt='Brown Cardboard Box on White Table [Ron Lach]')
            
            .repo__self
              span.repo__self-title= project.name
              span.repo__self-description= project.description
              .repo__self-author
                img.repo__self-author-avatar(src= project.owner.avatar_url alt= project.owner.login)
                span.repo__self-author-name= project.owner.login
            .repo__info.tags
              span.tag.repo__info-created Created: #{project.created_at}
              span.tag.repo__info-updated Updated: #{project.updated_at}
              span.tag.repo__info-size= project.size + ' Kilobytes'
              span.tag.repo__info-visibility= project.visibility
              span.tag.repo__info-language= project.language || 'None'
              span.tag.repo__info-stars= project.stargazers_count + ' Stars'
              span.tag.repo__info-issues= project.open_issues_count + ' Issues'