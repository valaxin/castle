section.section#products
  if (self.products)
    h2.title.section-title Shop
    ul.block
      each product of self.products
        li
          a.product(href= product.short_url target="_blank")
        
            if (product.preview_url)
              img(src= product.preview_url alt= product.name)
            else
              img(src='@images/resources/empty-package.jpg' alt='Brown Cardboard Box on White Table [Ron Lach]')
          
            .product__self
              span.product__self-title= product.name
              span.product__self-description= product.custom_summary
          
            .product__info.tags
              if (product.published === false)
                span.tag.product__info-price.is-warning Not Available
              if (product.max_purchase_count)
                span.tag.product__info-limit.is-danger Only #{product.max_purchase_count} Available
              span.tag.product__info-price= product.formatted_price