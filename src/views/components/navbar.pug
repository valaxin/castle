nav.navpill(role='navigation' aria-label='main navigation')
  .navpill-start

    if (back_button)
      .navpill-item
        a(href='/')
          span.material-icons.round subdirectory_arrow_left
    
    if (context)
      .navpill-item.current-post-title
        a= context.frontmatter.title
    
    .navpill-item.only-mobile
      button.mobile-menu-toggle
        span.material-icons.round egg


    .navpill-item
      button.color-scheme-toggle
        span.material-icons.round.scheme-button display_settings
    .navpill-item
      a(href='/#about')
        span.material-icons.round account_circle
    .navpill-item
      a(href='/#posts')
        span.material-icons.round attach_file
    .navpill-item
      a(href='/#projects')
        span.material-icons.round folder_special
    .navpill-item
      a(href='/#products')
        span.material-icons.round shopping_bag
    .navpill-item
      a.title(href='/')
        span.material-icons.round castle