section.section#posts
  if self.posts
    h2.title.is-4.has-text-weight-bold.has-text-centered Blog Posts
    ul.columns.is-multiline
      each post of self.posts
        li.column.is-4
          a.card(href=post.slug + '.html')
            .card-image
              figure
                img(src=post.frontmatter.thumbnail, alt=post.frontmatter.thumbnailAlt)
            .card-content
              .media
                .media-content
                  span.title.is-5= post.frontmatter.title
                  a.subtitle.is-6(href=post.frontmatter.authorUrl)= post.frontmatter.author
              p.content= post.frontmatter.summary
              .tags
                span.tag.is-info= post.fsize
                span.tag.is-primary= post.readTime + ' Minute(s) Read'
                span.tag.is-light= post.birthtime
