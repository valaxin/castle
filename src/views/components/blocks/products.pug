section.section#products
  if self.products
    h2.title.has-text-weight-bold.is-section-title Shop
    ul.columns.is-multiline
      each product of self.products
        li.column.is-4
          a.card(href=product.short_url, target="_blank")
            .card-image
              figure.image.is-16by9
                if product.preview_url
                  img(src=product.preview_url, alt=product.name)
                else
                  img(src='@images/resources/empty-package.jpg', alt='Brown Cardboard Box on White Table [Ron Lach]')
            .card-content
              span.title.is-5= product.name
              p.content.is-size-6= product.custom_summary
              if product.variants
                .mt-3
                  ol
                    each variant of product.variants
                      li
                        span= variant.title
              .tags.mt-3
                if product.published === false
                  span.tag.is-warning Not Available
                if product.max_purchase_count
                  span.tag.is-danger= 'Only ' + product.max_purchase_count + ' Available'
                span.tag.is-info= product.formatted_price
