section.section#projects
  if self.repos
    h2.title.is-3.has-text-weight-bold.has-text-centered Projects
    ul.columns.is-multiline
      each project of self.repos
        li.column.is-4
          a.card(href=project.html_url, target="_blank")
            .card-image
              figure.image.is-16by9
                if project.name === 'scrambled'
                  img(src='@images/resources/abstract.jpg', alt='Vibrant Abstract Digital Art with Fluid Dynamics [Steve Johnson]')
                else if project.name === 'castle'
                  img(src='@images/resources/castle.jpg', alt='Hohenschwangau Castle in Germany [Jusuf Rujanac]')
                else if project.name === 'valaxin'
                  img(src='@images/resources/great-wall.jpg', alt='Great Wall of China Snaking Through Verdant Hills [Jens F]')
                else
                  img(src='@images/resources/empty-package.jpg', alt='Brown Cardboard Box on White Table [Ron Lach]')
            .card-content
              .media
                .media-content
                  span.title.is-5= project.name
                  p.content.is-size-6= project.description
                  .is-flex.is-align-items-center.mt-3
                    figure.image.is-32x32.mr-2
                      img.is-rounded(src=project.owner.avatar_url, alt=project.owner.login)
                    span.has-text-weight-semibold= project.owner.login
              .tags.mt-3
                span.tag.is-light Created: #{project.created_at}
                span.tag.is-warning Updated: #{project.updated_at}
                span.tag.is-info= project.size + ' Kilobytes'
                span.tag.is-dark= project.visibility
                span.tag.is-primary= project.language || 'None'
                span.tag.is-success= project.stargazers_count + ' Stars'
                span.tag.is-danger= project.open_issues_count + ' Issues'
