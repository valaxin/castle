section.section.about

  div.block.about__banner
    h1.about__banner-title.is-sticker.is-1 About

  div.block.about__content.fixed-grid.has-2-col
    .about__grid.grid
      
      .about__grid-item.cell.is-col-span-2
        p.about__grid-item-title The Web Stack
        .group
          img.about__grid-item-image(src='@images/logos/svg/javascript.svg')
          img.about__grid-item-image(src='@images/logos/svg/html5.svg')
          img.about__grid-item-image(src='@images/logos/svg/css.svg')
        p.about__grid-item-summary Writing the big three for the last ten years, evolving and growing with the ecosystems of both server and client development.
      
      .about__grid-item.cell.is-col-span-1
        p.about__grid-item-title Databases
        .group
          img.about__grid-item-image(src='@images/logos/svg/mongodb.svg')
          img.about__grid-item-image(src='@images/logos/svg/sqlite.svg')
        p.about__grid-item-summary Great familiarity with popular database systems bot SQL and NoSQL alike.
     
      .about__grid-item.cell.is-col-span-1
        p.about__grid-item-title Other Langages
        .group
          img.about__grid-item-image(src='@images/logos/svg/python.svg')
          img.about__grid-item-image(src='@images/logos/svg/go.svg')
        p.about__grid-item-summary New to me, here to stay! Can be found digesting documentation under a heat lamp.
          
      .about__grid-item.cell.is-col-span-2
        p.about__grid-item-title Other Tools
        .group
          img.about__grid-item-image(src='@images/logos/svg/netlify.svg', alt="Netlify")
          img.about__grid-item-image(src='@images/logos/svg/nodedotjs.svg', alt="NodeJS")
          img.about__grid-item-image(src='@images/logos/svg/github.svg', alt="Github")
          img.about__grid-item-image(src='@images/logos/svg/htmx.svg', alt="HTMX")

        p.about__grid-item-summary Tools Im using nearly everyday in my workflow
          
      


