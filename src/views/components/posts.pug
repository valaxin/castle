
section.section.posts
  .grp.flex-row
    img.section-icon(src='@images/thiings/coffee.png' alt="a cup of coffee")
    h1.title.posts__title Posts
  h2.subtitle.posts__subtitle.is-6 Thoughts, Comments, Streams of Consciousness
  
  each post in self.posts
    if (post.frontmatter.visible === true)
      .post__item.mb-5
        a.posts__item.title(href= post.slug + '.html')= post.frontmatter.title
        ul
          li
            span.posts__item-summary= post.frontmatter.summary
          li
            if (post.frontmatter.published)
              span.posts__item-published.button.mt-2.mr-2.is-outlined.is-info.is-small= post.frontmatter.published
              span.posts__item-filesize.button.mt-2.mr-2.is-outlined.is-primary.is-small= post.fsize
            if (post.frontmatter.author)
              span.posts__item-author.button.mt-2.is-outlined.is-link.is-small= post.frontmatter.author
        