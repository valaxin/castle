section.section.cell
  h2.title.is-1 Notes
  h3.subtitle.is-6 -
  
  each post in self.posts
    if (post.frontmatter.visible === true)
      .block.mb-5
        a
          .item.title(href= post.slug + '.html')= post.frontmatter.title
          span.material-icons-round.is-flipped arrow_outward
          ul
            li
              img.thumbnail(src= post.frontmatter.thumbnail)
            li
              span.summary= post.frontmatter.summary
            li
              if (post.frontmatter.published)
                span.button.mt-2.mr-2.is-outlined.is-primary.is-small= post.frontmatter.published
                span.button.mt-2.mr-2.is-outlined.is-primary.is-small= post.fsize
              if (post.frontmatter.author)
                span.button.mt-2.is-outlined.is-primary.is-small= post.frontmatter.author