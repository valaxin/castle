footer.footer
  a.footer__owner(href= static.links.github target="_blank")= static.owner
  br
  span.footer__note content created by a human, computer assisted revisions possible, will notate.
  if static
  div.footer__pages
    each page of static.pages
      a.footer__pages-link(href= page.href)= page.title
  span.footer__year 2025
  a(href="/").footer__title= title

script(src="https://cdnjs.cloudflare.com/ajax/libs/tocbot/4.34.0/tocbot.min.js")