if gumroad
  .products
    ul.carousel
      each product in gumroad.products
        a(href='/#')
          li.carousel__item
            img.carousel__item-backdrop(src= product.preview_url)
            div.carousel__item-mask
            div.carousel__item-info
              h1.carousel__item-info-name= product.name
              h2.carousel__item-info-subtitle= product.custom_summary
            div.carousel__item-banner
              ul.carousel__item-info-tags
                li.carousel__item-info-tag
                  span.is-price.is-outline= product.formatted_price
                if product.published === false
                  li.carousel__item-info-tag
                    span Not Published!
                else 
                if product.max_purchase_count !== null
                  li.carousel__item-info-tag.tag.is-warning
                    span= product.max_purchase_count + ' Available'
    
  
    