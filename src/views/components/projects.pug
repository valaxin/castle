section.section.projects
  h1.title.projects__title Projects
  h2.subtitle.projects__subtitle Giv'em A Little Razzle-Dazzle
  
  ul
    each project in self.repos
      li
        a(href= project.owner.html_url + '/' + project.name + '.git')= project.name
          ul
            li
              span= project.description
            li
              span= project.language