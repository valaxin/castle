section.section.posts  
  .posts-container
    each post in self.posts
      if (post.frontmatter.visible === true)
        a.posts-container-item.mb-5.mt-5(href= post.slug + '.html')
          img.thumbnail(src= post.frontmatter.thumbnail).mr-5
          .group
            span.title.is-2.mt-5= post.frontmatter.title
            span.title.is-3.material-icons-round.is-flipped arrow_outward
            ul
              li.mb-5
                span.subtitle.is-mb-5summary= post.frontmatter.summary
            
              li.mt-5
                if post.frontmatter.tags
                  each tag in post.frontmatter.tags
                    span.mr-1.tag= tag
            
              li.mt-2
                if (post.frontmatter.author)
                  span.button.mt-2.mr-2.is-outlined.is-info.is-small= post.frontmatter.author
                if (post.frontmatter.published)
                  span.button.mt-2.mr-2.is-text.is-small= post.frontmatter.published
                  span.button.mt-2.is-text.is-small= post.fsize