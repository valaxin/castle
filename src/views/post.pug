extends /layout

block content

  main.article
    .post
      .post-hero
        h1.title= data.meta.title
        h2.subtitle #{data.meta.author} @ #{data.birthtime}
        if data.meta.tags
          .tags
            each tag in data.meta.tags
              span= tag
      .post-content
        include:markdown #{markdown-path-here}
      .post-comments
