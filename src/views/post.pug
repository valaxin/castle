extends layout

block content
  include templates/navigation
  main.post
    article.article.mb-5
      <!-- a(href='/').article__backbutton -->
        <!-- span.material-icons arrow_back -->
      figure.image
        img.article__hero(src=context.frontmatter.thumbnail, alt=context.frontmatter.thumbnailAlt)
        if (context.frontmatter.thumbnailAlt)
          .info.is-flex
            span.material-icons.round.is-small info
            span.subtitle.ml-2= context.frontmatter.thumbnailAlt
      h1.title.article__title.mt-5= context.frontmatter.title

      div.content.article__content
        != context.html
  
  button.gotop


  include templates/footer