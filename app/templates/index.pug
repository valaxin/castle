extends partials/layout

block content
  .container.index-content

    .content
      h1.title Hello World

    .content
      h3.subtitle My handle on most everything is 
       span.highlighted valaxin
       |  I am passionate about 
       span.highlighted.index-build 🔩building, 
       span.highlighted.index-fix  🛠️fixing,  
       | and 
       span.highlighted.index-mod 🕹️modifying
       | electronics and software for both fun and profit.
      
      .block
        // .block-decoration-one
        span.index-blurb This is my personal webspace, it's where I share projects, experiences, and services. You can also register for a repair, get in contact, or consume the media I share about repairs, mods, etc.
        // .block-decoration-two
        // .block-decoration-three
  br
  br
  .grid.is-col-min-12.index-first-cta
    
    a(href='/repair.html')  
      .cell
        span Mail-Order
        h2.title Repair
        h3.subtitle iPhones/Android, Computers, Tablets, Data Recovery Cleanings, and more.
        i.icon.fa-solid.fa-arrow-right
    
    a(href='/shop.html')  
      .cell
        span parts & services
        h2.title Shop
        h3.subtitle We have a variety of parts and services available for you.
        i.icon.fa-solid.fa-arrow-right
    
    a(href='/blog.html')  
      .cell
        span professional
        h2.title blog
        h3.subtitle writings about stuff I make, internet culture, music and more.
        i.icon.fa-solid.fa-arrow-right
  br
  br
  h2.projects-section-title Github 📦
  .grid.is-col-min-12
    for repo in repos
      a(href=repo.html_url target="_blank")
        .cell
          h3.title #{repo.name}
          p #{repo.description}
  
  h2.showcased-section-title ✨ CodePen
  .grid.is-col-min-12
    a(href="https://codepen.io/valaxin/details/AXMbyX" target="_blank")
      .cell
        h3.title Basic CSS3 Slider
        p Just a basic slider with button controls on the bottom
        .tags
          .tag May 27, 2013
          .tag 413 Loves
          .tag 210930 Views
    a(href="https://codepen.io/valaxin/details/BjepPG" target="_blank")
      .cell
        h3.title Another Toggle
        p simple bool toggle
        .tags
          .tag February 18, 2016
          .tag 147 Loves
          .tag 25894 Views
    
    a(href="https://codepen.io/valaxin/details/XdBKBe" target="_blank")
      .cell
        h3.title Simple Check
        p small checkmark styled to look pleasing and provide clear feedback
        .tags
          .tag April 21, 2016
          .tag 42 Loves
          .tag 2774 View

  include partials/footer
