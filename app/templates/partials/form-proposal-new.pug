form#quote

  .grid.is-col-min-10
  
    .cell
      h2 Use this form to make contact about a repair, request, or inquiry.
  

    .cell.is-col-span-3.is-row-span-2
      .field.is-grouped
        .control.has-icons-left.is-expanded
          input.input(placeholder="Name" type="text")
          span.icon.is-small.is-left
            i.fas.fa-user
        .control.has-icons-left.is-expanded
          input.input(placeholder="your@email" type="email")
          span.icon.is-small.is-left
            i.fas.fa-at
      .field
        .control
          textarea.textarea(placeholder="Questions? Comments? Concerns? \nQuests? Advice? dare I say... Admiration? \nLook forward to hearing from you!")
      .field
        .control
          button.button.is-link.has-icons-left.has-icons-right
            span.icon.is-small.is-left
              i.fa-solid.fa-paper-plane
            span Drop A Line!  
    .cell
      h2 Existing Customer Enter your ticket number here &nbsp;
        i.fa-solid.fa-arrow-right

    .cell.is-col-span-4
      .control
        label With submission you're in agreement with the 
          a(href="#terms") Terms of Service 
          | and 
          a(href="#privay") Privacy Policy.
        
